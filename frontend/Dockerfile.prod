FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package*.json ./
# Drop packages never needed for `next build` (Playwright/Vitest/ESLint).
# Keep TypeScript / Tailwind / @types — required to compile.
# --omit=peer skips Next's optional @playwright/test peer (and similar).
# Refresh the lockfile after deletes so npm ci stays consistent.
RUN --mount=type=cache,target=/root/.npm \
    npm pkg delete \
      devDependencies.@playwright/test \
      devDependencies.@axe-core/playwright \
      devDependencies.vitest \
      devDependencies.eslint \
      devDependencies.eslint-config-next \
 && npm install --package-lock-only --omit=peer \
 && npm ci --omit=peer \
      --fetch-retries=5 --fetch-retry-factor=2 --fetch-retry-maxtimeout=120000

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3001

ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
